[Unit]
# MS-01 eGPU RTX 3090 전력제한 영구화. 재부팅 시 자동으로 `nvidia-smi -pl 200`
# 적용해 팬 소음 (idle 278W → peak 200W 캡, fan 98% → 72%) 을 방지한다.
#
# 설치:
#   sudo cp infra/systemd/nvidia-power-limit.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nvidia-power-limit.service
#   systemctl status nvidia-power-limit.service
#
# 제거:
#   sudo systemctl disable --now nvidia-power-limit.service
#   sudo rm /etc/systemd/system/nvidia-power-limit.service
#   sudo nvidia-smi -pl 278   # 기본값 복원
Description=NVIDIA RTX 3090 power limit cap (eGPU fan noise mitigation)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
# 드라이버가 완전히 올라올 때까지 대기 (최대 60초).
ExecStartPre=/bin/sh -c 'i=0; until /usr/bin/nvidia-smi -L >/dev/null 2>&1; do i=$((i+1)); [ $i -ge 30 ] && exit 1; sleep 2; done'
ExecStart=/usr/bin/nvidia-smi -pl 200
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
