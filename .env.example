# Postgres
POSTGRES_PASSWORD=dev_password
POSTGRES_ADMIN_PASSWORD=dev_admin
PJ_RUNTIME_PASSWORD=dev_runtime
PJ_META_PASSWORD=dev_meta
PJ_UI_PASSWORD=dev_ui

# Redis
REDIS_PASSWORD=dev_redis

# LLM
LITELLM_MODEL_FAST=ollama/exaone3.5:32b
LITELLM_MODEL_DEFAULT=deepseek/deepseek-chat
LITELLM_MODEL_STRONG=deepseek/deepseek-chat
LITELLM_MODEL_REASONING=deepseek/deepseek-reasoner

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# KIS (Track C)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

# Telegram (Track C)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Docker data dir
DOCKER_DATA_DIR=./data

# Logging (모든 runner 공용)
LOG_LEVEL=INFO

# Dashboard (Track C, #4)
# 쉼표 구분 CORS allowlist. control-ui (Vite 기본 5173) 만 기본 허용.
DASHBOARD_CORS_ORIGINS=http://localhost:5173

# Monitor (Track C, #5)
MONITOR_POLL_INTERVAL_SEC=30

# Observability (Track E, profile=observe)
# docker compose --profile observe up → grafana admin 비밀번호
GRAFANA_PASSWORD=admin

# Cloudflare Tunnel (Track E, profile=tunnel, MS-01 전용)
# Zero Trust 대시보드에서 발급한 터널 토큰. 로컬 개발 시 비워두면 cloudflared 기동 실패.
CLOUDFLARE_TUNNEL_TOKEN=
