FROM python:3.12-slim

WORKDIR /app

# 시스템 의존성 (TZ)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# pyproject + 소스 복사
COPY pyproject.toml README.md ./
COPY prime_jennie_runtime ./prime_jennie_runtime

# uv 기반 editable install + kis optional deps
RUN pip install --no-cache-dir uv && \
    uv pip install --system -e ".[kis]"

# 토큰 캐시 디렉토리 (장중 재시작 금지 원칙 — 볼륨 마운트 받는 위치)
RUN mkdir -p /app/data/kis_token

EXPOSE 8080

CMD ["uvicorn", "prime_jennie_runtime.kis_gateway.server:create_app", \
     "--factory", "--host", "0.0.0.0", "--port", "8080"]
