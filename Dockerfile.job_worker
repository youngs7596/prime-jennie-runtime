FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY prime_jennie_runtime ./prime_jennie_runtime

# job_worker 는 crawlers (beautifulsoup4) + NaverNewsCrawler 재사용 — news extras.
# weekly_factor_analysis 는 pandas/numpy IC 계산 — screening extras.
# apscheduler / asyncpg / httpx / redis 는 core 의존.
RUN pip install --no-cache-dir uv && \
    uv pip install --system -e ".[news,screening]"

CMD ["python", "-m", "prime_jennie_runtime.jobs.app"]
