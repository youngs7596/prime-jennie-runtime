FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY prime_jennie_runtime ./prime_jennie_runtime

# kis schemas + apscheduler (core) + httpx
RUN pip install --no-cache-dir uv && \
    uv pip install --system -e ".[kis]"

CMD ["python", "-m", "prime_jennie_runtime.kis_gateway.price_scheduler_app"]
